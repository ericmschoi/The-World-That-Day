# Copy this file to .env in the repository root and fill in the values.
# Never commit .env.
#
# Format rule: the root .env is read by both Docker Compose and Spring Boot.
# Write plain KEY=value lines: no quotes, no `export`, no spaces around `=`.
#
# Server-only file. Browser keys (VITE_*) go in web/.env.example, not here.

# Local PostgreSQL (docker-compose.yml and server/src/main/resources/application.yml)
# Database name. Optional, default the_world_that_day.
# If you leave it unset, delete this line: Spring Boot treats an empty value as set.
POSTGRES_DB=
# Database user. Optional, default postgres.
# If you leave it unset, delete this line: Spring Boot treats an empty value as set.
POSTGRES_USER=
# Database password. Required. Compose refuses to start without it.
POSTGRES_PASSWORD=
# Host port mapped to the container's 5432. Optional, default 5432.
# If you leave it unset, delete this line: Spring Boot treats an empty value as set.
POSTGRES_PORT=

# Wikimedia API User-Agent (used from M3a, not read by the server yet)
# Format: TheWorldThatDay/<version> (<repository URL>)
WIKIMEDIA_USER_AGENT=
